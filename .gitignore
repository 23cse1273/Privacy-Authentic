# ==========================================
# Root .gitignore for Privacy Continuous Auth
# ==========================================

# --- Python & Backend ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
backend/env/
.venv/
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Database files (local development SQLite)
*.db
*.sqlite
*.sqlite3
backend/pca_database.db

# Pytest / Coverage / Tooling
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Node / React / Frontend ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Environment & Secret Files ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- IDEs & System Files ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
Desktop.ini
